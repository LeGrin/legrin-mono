{
  "name": "legrin-finance-pipeline",
  "version": "2.0.0",
  "private": true,
  "description": "Monobank and Revolut transaction pipeline for Google Calendar and KITT/Hermes Agent",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "register:monobank": "tsx scripts/register-monobank-webhook.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.1",
    "fastify-raw-body": "^5.0.0",
    "googleapis": "^160.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
