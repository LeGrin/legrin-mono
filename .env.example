NODE_ENV=production
HOST=0.0.0.0
PORT=8088
LOG_LEVEL=info
DATABASE_PATH=/app/data/finance.db
TIMEZONE=Europe/Zagreb

# Generate independently, for example: openssl rand -hex 32
WEBHOOK_SHARED_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_API_TOKEN=replace-with-another-32-random-bytes

# Monobank personal API
MONOBANK_TOKEN=
PUBLIC_BASE_URL=https://finance.example.com

# Revolut Business only. Personal Revolut needs a separate adapter/aggregator.
REVOLUT_WEBHOOK_SIGNING_SECRET=
REVOLUT_TIMESTAMP_TOLERANCE_SECONDS=300

# Share the target calendar with this service account email.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
# Alternative to GOOGLE_SERVICE_ACCOUNT_FILE:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or reuse the VPS google-sidecar user OAuth session instead of a service account:
GOOGLE_SIDECAR_URL=
GOOGLE_SIDECAR_TOKEN=
GOOGLE_SIDECAR_USER_ID=

# KITT Hermes Agent API, reachable through the shared Docker network.
HERMES_AGENT_URL=http://kitt-hermes:8080
HERMES_AGENT_KEY=
HERMES_AGENT_TIMEOUT_MS=150000

# Use the Telegram bot/chat through which you talk to KITT.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Major currency units per month.
MONTHLY_BUDGETS_JSON={"EUR":2910,"UAH":60000}
CATEGORY_BUDGETS_JSON={"Restaurants & coffee":{"EUR":300},"Food & groceries":{"EUR":500}}
CATEGORY_CONFIDENCE_THRESHOLD=0.72
WORKER_INTERVAL_MS=750
MAX_DELIVERY_ATTEMPTS=12
